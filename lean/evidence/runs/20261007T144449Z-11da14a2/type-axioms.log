LogTwo.Analysis.actual_analytic_summand_exp_bound {m : ℕ} {w : LogTwo.Interpolation.Weights m} {H : ℚ} {r : Fin m → ℚ}
  {T : Fin m → ℕ} (minor : LogTwo.Interpolation.FullRowMinor w H r T) (hK : 0 < w.K) (hH : 0 < H) {wstar : ℝ}
  (hws : 0 < wstar) (hw : ∀ (k : Fin m), wstar ≤ ↑(w.w k))
  (f :
    (i : Fin minor.size) →
      OAI.PiExponent.RowTranslation.RowChoices
        (OAI.PiExponent.MatrixTranslation.transverseIndices (fun k => ↑(w.w k)) ↑H)
        (OAI.PiExponent.InterpolationMatrix.exponentVector (minor.rows i).beta) (minor.rows i).s) :
  let S := OAI.PiExponent.MatrixTranslation.transverseIndices (fun k => ↑(w.w k)) ↑H;
  ‖Matrix.det fun i c => LogTwo.Analysis.actualAnalyticRow (minor.rows i) S (f i) (minor.columns c)‖ ≤
    Real.exp
      (-(Real.log 2 / 4) * ∑ a, ↑(OAI.PiExponent.Collision.multiplicity Finset.univ (fun i => (f i).fst) a) ^ 2 +
        ↑minor.size * ↑H *
          (100 * ↑w.K / ↑w.w0 + Real.log (200 * ↑w.K) / wstar + Real.log 2 / ↑w.v0 +
            OAI.PiExponent.Collision.collisionRemainder minor.size ↑H))
LogTwo.Analysis.norm_choiceScalar_le {m : ℕ} {w : LogTwo.Interpolation.Weights m} {H : ℚ} {r : Fin m → ℚ}
  {T : Fin m → ℕ} (minor : LogTwo.Interpolation.FullRowMinor w H r T) (hK : 0 < w.K) (hH : 0 < H) {C ν F ws : ℝ}
  (hC : 0 ≤ C) (hν : 0 ≤ ν) (hF : 0 < F) (hws : 0 < ws) (hw : ∀ (k : Fin m), ws ≤ ↑(w.w k))
  (hT : ∀ (k : Fin m), 1 ≤ T k) (hTw : ∀ (k : Fin m), F * ↑(w.w k) ≤ ↑w.v0 * ↑(T k))
  (he :
    ∀ (i : Fin minor.size) (k : Fin m), ‖↑(minor.rows i).j * (↑(r k) - ↑(Real.log 2))‖ ≤ Real.exp (C - ν * ↑(w.w k)))
  (f : LogTwo.Analysis.MinorChoice minor) :
  ‖LogTwo.Analysis.choiceScalar minor f‖ ≤
    Real.exp
      (-ν *
          (∑ i, LogTwo.Analysis.indexWeight w ↑(f i).fst -
            ↑minor.size * ↑H * LogTwo.Arithmetic.averageRowWeight minor) +
        ↑minor.size * ↑H * LogTwo.Analysis.translationBudget w C ν F ws)
LogTwo.Analysis.actual_minor_log_bound_of_approximations {m : ℕ} {w : LogTwo.Interpolation.Weights m} {H F : ℚ}
  (r : Fin m → ℚ) (q : Fin m → ℕ)
  (minor : LogTwo.Interpolation.FullRowMinor w H r (LogTwo.Arithmetic.truncationOrders w F)) (hK : 0 < w.K) (hH : 0 < H)
  (hF : 0 < F) {ν ws A η : ℝ} (hν : 0 ≤ ν) (hws : 0 < ws) (hA : 0 ≤ A) (hη : 0 ≤ η) (hq : ∀ (k : Fin m), 2 ≤ q k)
  (hwq : ∀ (k : Fin m), w.w k = LogTwo.Arithmetic.ceilLogWeight (q k)) (hw : ∀ (k : Fin m), ws ≤ ↑(w.w k))
  (happrox : ∀ (k : Fin m), |Real.log 2 - ↑(r k)| ≤ ↑(q k) ^ (-ν)) :
  Real.log |↑minor.matrix.det| / (↑minor.size * ↑H) ≤
    LogTwo.Analysis.combinedAnalyticBudget minor (Real.log ↑w.K + ν) ν (↑F) ws A η +
      Real.log ↑(LogTwo.Analysis.rowChoiceCount w H) / ↑H
