LogTwo.Geometry.exists_small_arithmetic_separated_parameters (n : ℕ) (hn : 1 ≤ n) {x ν : ℝ}
  (hbad : LogTwo.UnboundedApproximations x ν) (ε : ℝ) (hε : 0 < ε) (M : ℕ → ℝ) (hM : ∀ (m : ℕ), 0 < M m)
  (threshold : ℕ → (i : ℕ) → (Fin i → ℕ) → ℝ) :
  ∃ m p q,
    ∃ (hq : ∀ (i : ℕ), 2 ≤ q i),
      ∃ W,
        1 ≤ m ∧
          0 < W ∧
            (∀ (i : ℕ), W ≤ ↑(LogTwo.Arithmetic.ceilLogWeight (q i))) ∧
              (∀ (i : ℕ), (threshold m i fun j => q ↑j) < Real.log ↑(q i)) ∧
                (∀ (i : ℕ), |x - ↑(p i) / ↑(q i)| ≤ ↑(q i) ^ (-ν)) ∧
                  (∀ i < m,
                      LogTwo.Geometry.denominatorSeparationFactor n m (M m) *
                          ∏ j, ↑(LogTwo.Arithmetic.ceilLogWeight (q ↑j)) <
                        ↑(LogTwo.Arithmetic.ceilLogWeight (q i))) ∧
                    LogTwo.Arithmetic.arithmeticError (LogTwo.chosenWeights n hn m (fun i => q ↑i) ⋯)
                          (LogTwo.Parameters.truncationFactor n) W <
                        ε ∧
                      LogTwo.Geometry.SeparatedProducts
                        (LogTwo.Geometry.columnWeight (LogTwo.chosenWeights n hn m (fun i => q ↑i) ⋯))
                        (fun i => ↑(LogTwo.Geometry.jetWeight (LogTwo.chosenWeights n hn m (fun i => q ↑i) ⋯) i)) (M m)
LogTwo.Geometry.chosenWeights_contact_bound_of_comparison.{u_1} {E : Type u_1} [Field E] [Algebra ℂ E]
  (hres :
    ∀ (p : OAI.PiExponent.CurveValuationCenter.NormalizedPlace ℂ E),
      Algebra.IsIntegral ℂ (IsLocalRing.ResidueField ↥(OAI.PiExponent.PlaceValuationRing.ring p)))
  (hfinite : ∀ (f : E), Transcendental ℂ f → FiniteDimensional (↥ℂ⟮f⟯) E) (n : ℕ) (hn : 1 ≤ n) (m : ℕ) (q : ℕ → ℕ)
  (hq : ∀ (i : ℕ), 2 ≤ q i) (M : ℝ) (hM : 0 < M)
  (hgrowth :
    ∀ i < m,
      LogTwo.Geometry.denominatorSeparationFactor n m M * ∏ j, ↑(LogTwo.Arithmetic.ceilLogWeight (q ↑j)) <
        ↑(LogTwo.Arithmetic.ceilLogWeight (q i)))
  (z : Fin (m + 1) → E) (hz : ∃ i, Transcendental ℂ (z i)) :
  let w := LogTwo.chosenWeights n hn m (fun i => q ↑i) ⋯;
  have hK := ⋯;
  ∀ (y : Fin w.K → ℂ) (hy : ∀ (j : Fin w.K), y j ≠ 0),
    Function.Injective y →
      ∀ (c : Fin w.K → Fin m → ℂ),
        LogTwo.Geometry.EventualKernelComparison z (LogTwo.Geometry.columnWeight w)
            (fun i => ↑(LogTwo.Geometry.jetWeight w i)) M ↑(LogTwo.Geometry.curveSigma w.theta m) →
          (1 + ↑(LogTwo.Geometry.curveSigma w.theta m)) *
              ∑ p ∈ LogTwo.Geometry.ContactFamilyAt.places hfinite z y c hz,
                ↑(LogTwo.Geometry.ContactFamilyAt.contact hres hfinite z y hy c hz hK (LogTwo.Geometry.jetWeight w) p) ≤
            OAI.PiExponent.CurveContactSum.weightedDegree hfinite z (LogTwo.Geometry.rationalColumnWeight w)
