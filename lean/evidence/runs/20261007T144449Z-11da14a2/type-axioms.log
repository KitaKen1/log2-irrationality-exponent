        ∀ (k : ℕ),
          N ≤ k →
            Function.Surjective
              (OAI.PiExponent.BlowupJetSurjectivity.jetRestriction
                (LogTwo.Geometry.MatrixCompactification.logTwoIdeal w r (LogTwo.Arithmetic.truncationOrders w F))
                (LogTwo.Geometry.MatrixBlowup.hyperplane w) k)
