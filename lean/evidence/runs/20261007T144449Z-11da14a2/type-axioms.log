LogTwo.exists_small_total_parameters (n : ℕ) (hn : 1 ≤ n) {x : ℝ}
  (hbad : LogTwo.UnboundedApproximations x ↑(LogTwo.Parameters.nu n)) :
  ∃ m p q,
    ∃ (hq : ∀ (i : ℕ), 2 ≤ q i),
      ∃ W,
        1 ≤ m ∧
          0 < W ∧
            (∀ (i : ℕ), W ≤ ↑(LogTwo.Arithmetic.ceilLogWeight (q i))) ∧
              (∀ i < m,
                  LogTwo.Geometry.denominatorSeparationFactor n m (LogTwo.Geometry.chosenComparisonConstant n m) *
                      ∏ j, ↑(LogTwo.Arithmetic.ceilLogWeight (q ↑j)) <
                    ↑(LogTwo.Arithmetic.ceilLogWeight (q i))) ∧
                (∀ (i : ℕ), |x - ↑(p i) / ↑(q i)| ≤ ↑(q i) ^ (-↑(LogTwo.Parameters.nu n))) ∧
                  have w := LogTwo.chosenWeights n hn m (fun i => q ↑i) ⋯;
                  LogTwo.Arithmetic.arithmeticError w (LogTwo.Parameters.truncationFactor n) W +
                        LogTwo.Analysis.fixedAnalyticError w (↑(LogTwo.Parameters.nu n))
                          (↑(LogTwo.Parameters.truncationFactor n)) W <
                      ↑(LogTwo.Parameters.epsilon n) ∧
                    2 <
                      LogTwo.Analysis.collisionLimit w ↑(LogTwo.Parameters.a (LogTwo.Parameters.delta n))
                        ↑(LogTwo.Parameters.eta n)
