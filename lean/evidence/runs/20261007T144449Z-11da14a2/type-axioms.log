LogTwo.Analysis.coefficientMatrix_eq_scaled_entry {m : ℕ} (r : Fin m → ℚ) (T : Fin m → ℕ)
  (row : LogTwo.Interpolation.Row m) (col : LogTwo.Interpolation.Column m) :
  ↑(LogTwo.Interpolation.coefficientMatrix r T row col) =
    2 ^ (row.j * col.h) *
      OAI.PiExponent.InterpolationMatrix.entry (fun i => ↑(r i))
        (fun i => OAI.PiExponent.InterpolationMatrix.truncatedLog (T i)) row.j row.s row.beta col.h col.alpha
LogTwo.Analysis.actual_minor_analytic_expansion_weighted {m : ℕ} {w : LogTwo.Interpolation.Weights m} {H : ℚ}
  {r : Fin m → ℚ} {T : Fin m → ℕ} (minor : LogTwo.Interpolation.FullRowMinor w H r T) :
  have S := OAI.PiExponent.MatrixTranslation.transverseIndices (fun k => ↑(w.w k)) ↑H;
  (Matrix.det fun i c => ↑(minor.matrix i c)) =
    ∑ f,
      (∏ i, LogTwo.Analysis.actualRowScalar r T (minor.rows i) S (f i)) *
        Matrix.det fun i c => LogTwo.Analysis.actualAnalyticRow (minor.rows i) S (f i) (minor.columns c)
LogTwo.Analysis.actual_minor_row_hasSum {m : ℕ} {w : LogTwo.Interpolation.Weights m} {H : ℚ} {r : Fin m → ℚ}
  {T : Fin m → ℕ} (minor : LogTwo.Interpolation.FullRowMinor w H r T) (hH : 0 ≤ H) {wstar : ℝ} (hws : 0 < wstar)
  (hw : ∀ (k : Fin m), wstar ≤ ↑(w.w k)) (S : Finset (Fin m →₀ ℕ)) (i c : Fin minor.size)
  (t :
    OAI.PiExponent.RowTranslation.RowChoices S (OAI.PiExponent.InterpolationMatrix.exponentVector (minor.rows i).beta)
      (minor.rows i).s) :
  HasSum
    (fun d =>
      (OAI.PiExponent.AnalyticCollision.rowTest ((minor.rows i).s - ↑t.snd.2) fun z =>
          ((↑(minor.rows i).j * ↑(Real.log 2) + Complex.log (1 + z)) / (100 * ↑w.K)) ^ d) *
        OAI.PiExponent.AnalyticCollision.normalizedTaylorCoeff
          (OAI.PiExponent.PeriodAnalytic.columnFunction (minor.columns c).h (minor.columns c).alpha ↑t.fst) (100 * ↑w.K)
          d)
    (LogTwo.Analysis.actualAnalyticRow (minor.rows i) S t (minor.columns c))
