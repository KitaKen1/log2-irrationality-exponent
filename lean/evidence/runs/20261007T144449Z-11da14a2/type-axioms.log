LogTwo.Geometry.logTwo_intrinsic_contact_bound.{u_1} {E : Type u_1} [Field E] [Algebra ℂ E] [Algebra.EssFiniteType ℂ E]
  (n : ℕ) (hn : 1 ≤ n) (m : ℕ) (q : ℕ → ℕ) (hq : ∀ (i : ℕ), 2 ≤ q i)
  (hgrowth :
    ∀ i < m,
      LogTwo.Geometry.denominatorSeparationFactor n m (LogTwo.Geometry.chosenComparisonConstant n m) *
          ∏ j, ↑(LogTwo.Arithmetic.ceilLogWeight (q ↑j)) <
        ↑(LogTwo.Arithmetic.ceilLogWeight (q i)))
  (z : Fin (m + 1) → E) (hgen : IntermediateField.adjoin ℂ (Set.range z) = ⊤) (htrdeg : Algebra.trdeg ℂ E = 1)
  (r : Fin m → ℚ) :
  have hres := ⋯;
  have hfinite := ⋯;
  have hz := ⋯;
  let w := LogTwo.chosenWeights n hn m (fun i => q ↑i) ⋯;
  have hK := ⋯;
  let y := fun j => 2 ^ ↑j;
  have hy := ⋯;
  have c := fun j i => ↑↑j * ↑(r i);
  (1 + ↑(LogTwo.Geometry.curveSigma w.theta m)) *
      ∑ p ∈ LogTwo.Geometry.ContactFamilyAt.places hfinite z y c hz,
        ↑(LogTwo.Geometry.ContactFamilyAt.contact hres hfinite z y hy c hz hK (LogTwo.Geometry.jetWeight w) p) ≤
