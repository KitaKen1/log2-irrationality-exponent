  change ((Spec.map (CommRingCat.ofHom (algebraMap ℂ B))).appTop ≫
    (Scheme.ΓSpecIso (CommRingCat.of B)).hom)
      ((Scheme.ΓSpecIso (CommRingCat.of ℂ)).inv c) = _
