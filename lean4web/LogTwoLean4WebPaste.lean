      Function.Surjective ε ∧
      LinearMap.range ((iterateScalarCones C rs).d 1 0).hom = LinearMap.ker ε ∧
      ∀ n, LinearMap.range ((iterateScalarCones C rs).d (n + 2) (n + 1)).hom =
