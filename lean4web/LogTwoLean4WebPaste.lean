    (f : E) (hf : Transcendental F f) : Type _ :=
  let := parameterLaurentAlgebra f hf
  integralClosure (LaurentPolynomial F) E

def parameterChartOverlapHom {F E : Type*} [Field F] [Field E] [Algebra F E]
