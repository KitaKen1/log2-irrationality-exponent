lemma isoPreimageSectionRingEquiv_symm (X Y : Scheme) (f : X ≅ Y) (V : Y.Opens)
    (a : Γ(Y,V)) :
    (isoPreimageSectionRingEquiv f V).symm a = f.hom.app V a := by logtwo_quiet
  change (((IsOpenImmersion.ΓIso f.hom V) ≪≫
    Y.presheaf.mapIso (eqToIso (show V = f.hom.opensRange ⊓ V by logtwo_quiet
