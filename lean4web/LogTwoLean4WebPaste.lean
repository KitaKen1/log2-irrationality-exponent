    parameterLaurentMap f hf (LaurentPolynomial.T 1) = f := by logtwo_quiet
  simp [parameterLaurentMap, LaurentPolynomial.eval₂_T]

@[simp]
theorem parameterLaurentMap_T_inv {F E : Type*} [Field F] [Field E] [Algebra F E]
