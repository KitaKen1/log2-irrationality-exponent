    (a : ι → PowerSeries ℂ) (hne : ∃ i, a i ≠ 0)
    (hc : ∀ i, PowerSeries.constantCoeff (a i) = 0) : 0 < contact v a hne := by logtwo_quiet
  obtain ⟨i,hi,he⟩ := exists_attains v a hne
  rw [he]
