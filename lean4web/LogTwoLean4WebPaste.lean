    (I : X.IdealSheafData) (f : Y ⟶ X)
    (J₁ J₂ : LineBundle Y)
    (ι₁ : J₁.sheaf ⟶ structureSheaf Y) (ι₂ : J₂.sheaf ⟶ structureSheaf Y)
