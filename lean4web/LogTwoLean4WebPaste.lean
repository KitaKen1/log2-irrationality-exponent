    map_smul' := ?_ }
  intro c x
  change Γ(Spec (CommRingCat.of B), ⊤) at x
  change (Scheme.ΓSpecIso (CommRingCat.of B)).hom
    (baseScalars (algebraStructureMap B) c * x) =
      c • (Scheme.ΓSpecIso (CommRingCat.of B)).hom x
