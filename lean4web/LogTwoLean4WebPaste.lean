def integralClosureTowerHom
    {R S E : Type*} [CommRing R] [CommRing S] [CommRing E]
    [Algebra R S] [Algebra R E] [Algebra S E] [IsScalarTower R S E] :
    integralClosure R E →+* integralClosure S E where
  toFun x := ⟨x.1, x.2.tower_top⟩
  map_zero' := rfl
  map_one' := rfl
  map_add' _ _ := rfl
  map_mul' _ _ := rfl

