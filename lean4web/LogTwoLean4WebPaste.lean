  obtain ⟨I, hI⟩ := isCompact_univ.elim_finite_subcover
    (fun x => (U x : Set X)) (fun x => (U x).isOpen)
    (by logtwo_quiet intro x _; exact Set.mem_iUnion.mpr ⟨x, hUx x⟩)
