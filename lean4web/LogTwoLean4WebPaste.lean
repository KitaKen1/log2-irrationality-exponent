      WeightedBezout.pointIdeal (0 : Fin (m+1) → k) := by logtwo_quiet
    ext P
    change MvPolynomial.aeval (center c) (inverseTriangularMap c G P) = 0 ↔
      MvPolynomial.aeval (0 : Fin (m+1) → k) P = 0
