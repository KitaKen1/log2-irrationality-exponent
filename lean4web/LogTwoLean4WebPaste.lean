      hdim, Nat.cast_zero, mul_zero, add_zero]

theorem cartier_euler_difference
    (p : X ⟶ Spec (CommRingCat.of ℂ))
    (M N : LineBundle X) (φ : M.sheaf ⟶ N.sheaf) [Mono φ]
