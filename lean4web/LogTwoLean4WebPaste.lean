theorem coordinateKernel_height_le {m : ℕ}
    (p : NormalizedPlace ℂ E)
    [Algebra.IsIntegral ℂ (IsLocalRing.ResidueField (ring p))]
    (z : Fin (m+1) → E) (a : Fin (m+1) → ℂ) (hc : Centered z a p)
