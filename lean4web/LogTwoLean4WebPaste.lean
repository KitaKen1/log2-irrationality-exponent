    GeometrySupport.CechHigher.HasPrimitives X.ringCatSheaf U M q := by logtwo_quiet
  intro c hc
  have hregular : ProjectiveMonomialCechHigher.Regular (P.toLaurent c) :=
    fun t => P.regular _ t _
  have hclosed : ProjectiveMonomialCechHigher.differential (P.toLaurent c) = 0 := by logtwo_quiet
    rw [← P.toLaurent_differential, hc]
    funext t
    exact map_zero _
