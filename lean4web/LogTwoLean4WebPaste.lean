    (hg : Function.Surjective (fun s : GlobalSections X M.sheaf => pullbackSection g s))
    (hY : ∀ y : Y, ∃ s : GlobalSections Y (M.pullback f).sheaf, y ∈ sectionOpen Y s)
    (hZ : ∀ z : Z, ∃ s : GlobalSections Z (M.pullback g).sheaf, z ∈ sectionOpen Z s) :
