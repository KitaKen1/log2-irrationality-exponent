  erw [chartEvaluation_mk]
  rw [imageEvaluation_gradedImageMap]
  have h := evalAway_mk_clear (affineMonomialMap (R := R) a) (poly_X_mem z)
    (show IsUnit (affineMonomialMap (R := R) a (X z)) from by logtwo_quiet
