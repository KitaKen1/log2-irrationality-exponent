theorem parameterChartOverlap_isOpenImmersion
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    (f : E) (hf : Transcendental F f) :
    IsOpenImmersion (Spec.map (CommRingCat.ofHom (parameterChartOverlapHom f hf))) := by logtwo_quiet
