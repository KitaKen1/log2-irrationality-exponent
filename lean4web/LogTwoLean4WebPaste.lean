    [IsNoetherianRing A] [IsLocalRing A] : Prop :=
  ∀ (I : Ideal A) (x : A),
    ringKrullDim (A ⧸ I) = 1 →
    Function.Injective (quotientMul I x) →
    (I ⊔ Ideal.span {x}).IsPrimary →
    (I ⊔ Ideal.span {x}).radical = IsLocalRing.maximalIdeal A →
    Module.length A (A ⧸ (I ⊔ Ideal.span {x})) = minimalPrimeCutSum I x

