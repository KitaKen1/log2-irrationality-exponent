    (v : Fin (m+1) → ℚ) (hv : ∀ i, 0 ≤ v i) (H : ℚ) :
    Ideal (PiExponentApprox.FramePolynomial m) :=
  RingHom.ker (algebraicJetMap c T v hv H)

