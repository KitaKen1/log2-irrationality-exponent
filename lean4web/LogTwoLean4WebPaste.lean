def ordinaryPowerEquivPiece (I : Ideal R) (n : ℕ) : ↥(I ^ n : Ideal R) ≃ₗ[R] piece I n where
  toFun a := ⟨⟨monomial n a.val, reesAlgebra.monomial_mem.mpr a.property⟩,
