      (Scheme.Modules.restrictFunctor U.1.ι).map (tensorInclusion J M ι) ≫ f.hom) := by logtwo_quiet
    erw [tensor_inclusion_framed]
    have hmap : Mono (C := U.1.toScheme.Modules)
