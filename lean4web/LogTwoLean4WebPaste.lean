theorem isAmple_of_global_frame_affine [IsAffine X] (L : LineBundle X)
    (e : L.sheaf ≅ structureSheaf X) : L.IsAmple := by logtwo_quiet
  intro x V hx
  obtain ⟨r,hr,hxr⟩ := (isAffineOpen_top X).exists_basicOpen_le ⟨x,hx⟩ (by logtwo_quiet trivial)
  let E := globalPowerFrame e 1
