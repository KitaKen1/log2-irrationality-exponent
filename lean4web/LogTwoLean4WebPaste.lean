    have hbound := hlow.trans (add_le_add (sectionZero_pullback_dimension_le H s i) le_rfl)
    apply ENat.WithBot.add_le_add_one_right_iff.mp
    simpa only [Nat.cast_add, Nat.cast_one] using hbound

