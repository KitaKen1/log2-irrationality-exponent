  refine ⟨a*(N+1),Nat.mul_pos ha (by logtwo_quiet omega),k,fun z => t z ≫ e.hom,?_⟩
  exact (iSup_congr fun j =>
    PiExponent.AmpleIso.sectionOpen_postcomp_iso (t j) e).trans ht

