    (imageIdealSheaf_eq_comap I f J ι hJ)

theorem inclusion_structureMap_zero
    (I : X.IdealSheafData) (f : Y ⟶ X)
    (J : LineBundle Y) (ι : J.sheaf ⟶ structureSheaf Y)
