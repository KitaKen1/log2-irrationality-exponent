  apply hom_ext_affine
  intro U
  ext x
  change (I.comap f).subschemeι.app U.1 (ι.app U.1 x) = 0
  apply RingHom.mem_ker.mp
  rw [(I.comap f).ker_subschemeι_app U, ← presented_range_eq I f J ι hJ U]
