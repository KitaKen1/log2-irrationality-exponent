abbrev Cochain (ι A : Type*) (q : ℕ) := (Fin (q + 1) → ι) → A

def differential {q : ℕ} (c : Cochain ι A q) : Cochain ι A (q + 1) :=
  fun t => ∑ k : Fin (q + 2), (-1 : ℤ) ^ k.val • c (t ∘ k.succAbove)

