    (hX : X none ∈ J) (n : ℕ) :
    Module.finrank k (PiExponentJets.W64.quotientSection J n) =
      Module.finrank k (PiExponentJets.W64.quotientSection (coordinateImageIdeal J) n) :=
  (coordinateQuotientSectionEquiv J hX n).finrank_eq

end

