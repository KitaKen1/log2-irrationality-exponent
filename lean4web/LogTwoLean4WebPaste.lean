      f.appLE V V' eV (Y.presheaf.map (homOfLE h).op x) := by logtwo_quiet
  change (f.appLE U U' eU ≫ X.presheaf.map (homOfLE h').op) x =
    (Y.presheaf.map (homOfLE h).op ≫ f.appLE V V' eV) x
