    ((Scheme.ΓSpecIso (CommRingCat.of (PolyChart (R := K) i))).inv (polyToChart i q)) = _
  rw [← Scheme.Hom.comp_appTop_assoc, hg, Scheme.ΓSpecIso_naturality]
  change v ((Scheme.ΓSpecIso (CommRingCat.of (PolyChart (R := K) i))).hom
    ((Scheme.ΓSpecIso (CommRingCat.of (PolyChart (R := K) i))).inv (polyToChart i q))) = _
