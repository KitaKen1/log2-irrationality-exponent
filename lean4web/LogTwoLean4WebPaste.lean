  have hi : (i.factorial : ℚ) ≠ 0 := by logtwo_quiet exact_mod_cast Nat.factorial_ne_zero i
  have hj : (j.factorial : ℚ) ≠ 0 := by logtwo_quiet exact_mod_cast Nat.factorial_ne_zero j
