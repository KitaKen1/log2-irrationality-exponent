    (Q : Ideal (MvPolynomial ι K)) [Q.IsPrime] (A : Finset ι) (i : Fin A.card) :
    residueEquiv Q A
      (algebraMap (MvPolynomial ι K) Q.ResidueField (MvPolynomial.X (A.equivFin.symm i).val)) =
