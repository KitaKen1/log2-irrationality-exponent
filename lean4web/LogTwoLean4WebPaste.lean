    degreeMargin w y hy0 a T * (curveDegree (structureMap w y a T) (H w y hy0 a T) C : ℝ) ≤
      (curveDegree (structureMap w y a T) (interpolationBundle w y a T) C : ℝ) := by logtwo_quiet
