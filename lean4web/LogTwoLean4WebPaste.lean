variable {m K : ℕ} (w : Weights m) (y : Fin K → ℂ)
variable (hy0 : ∀ j, y j ≠ 0) (a : Fin K → Fin m → ℂ) (T : Fin m → ℕ)

def interpolationBundle : LineBundle (space w y a T) :=
  (A w y a T).tensor (J w y a T)

