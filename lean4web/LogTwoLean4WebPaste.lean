theorem hom_glue {J : Type u} (U : J → Opens X) (V : Opens X)
    (hUV : ∀ i, U i ≤ V) (hcover : V ≤ ⨆ i, U i)
    (M : SheafOfModules.{u} R) (f : ∀ i, freeOpen R (U i) ⟶ M)
    (hf : ∀ i j, freeOpenMap R (homOfLE (show U i ⊓ U j ≤ U i from inf_le_left)) ≫ f i =
