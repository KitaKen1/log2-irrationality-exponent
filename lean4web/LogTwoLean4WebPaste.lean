  have hsurj : Function.Surjective f := by logtwo_quiet
    intro a
    obtain ⟨i, hi⟩ := minor.all_rows (rowOfIndex a) (rowOfIndex_valid a)
    exact ⟨i, (rowOfIndex_injective w H) ((hf i).trans hi)⟩
