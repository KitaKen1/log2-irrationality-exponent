def weightedIdeal (w : σ → ℕ) (N : ℕ) : Ideal (MvPowerSeries σ R) where
  carrier := {f | (N : ℕ∞) ≤ f.weightedOrder w}
  zero_mem' := by logtwo_quiet simp
  add_mem' hf hg := (le_min hf hg).trans (min_weightedOrder_le_add w)
