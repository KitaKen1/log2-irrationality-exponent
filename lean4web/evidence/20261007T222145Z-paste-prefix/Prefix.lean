  have hx0 : Ideal.Quotient.mk P x ≠ 0 := by logtwo_quiet
    simpa only [ne_eq, Ideal.Quotient.eq_zero_iff_mem] using hx
  intro y z hyz
  change x • y = x • z at hyz
