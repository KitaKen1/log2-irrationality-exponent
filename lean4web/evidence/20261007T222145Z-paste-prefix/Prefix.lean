    (hzero : LinearMap.range (C.d 1 0).hom = LinearMap.ker π)
    (hexact : ∀ n, LinearMap.range (C.d (n + 2) (n + 1)).hom =
      LinearMap.ker (C.d (n + 1) n).hom)
    (hreg : RingTheory.Sequence.IsRegular Q rs) :
    ∃ ε : (iterateScalarCones C rs).X 0 →ₗ[R]
