      apply Finset.sum_le_sum
      intro i _
      exact mul_le_mul_of_nonneg_left (hcoord i) (Nat.cast_nonneg _)
    _ = (∑ i, w i * (a i : ℚ)) * weightedPole w z := by logtwo_quiet
      rw [Finset.sum_mul]
      apply Finset.sum_congr rfl
      intro i _
      ring
