  · apply div_nonneg _ (mul_pos hM hH').le
    apply Finset.sum_nonneg
    intro i _
    apply Finset.sum_nonneg
    intro k _
    exact mul_nonneg (by logtwo_quiet exact_mod_cast (w.w_pos k).le) (Nat.cast_nonneg _)
