        apply Finset.sum_lt_sum
        · intro i _; exact (rowWeight_lt w H _ (minor.row_valid i)).le
        · exact ⟨⟨0, hsize⟩, Finset.mem_univ _, rowWeight_lt w H _ (minor.row_valid _)⟩
