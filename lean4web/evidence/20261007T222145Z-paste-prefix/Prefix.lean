  · let J : X.IdealSheafData := Scheme.IdealSheafData.ofIdealTop
      ((I.ideal ⟨⊤, isAffineOpen_top Y⟩).map f.appTop.hom)
    have h : I ≤ J.map f := by logtwo_quiet
      apply Scheme.IdealSheafData.le_of_isAffine
      rw [map_top]
