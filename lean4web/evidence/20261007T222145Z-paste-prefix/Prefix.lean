    expansion ρ π hπ hker (algebraMap C A c) = PowerSeries.C c := by logtwo_quiet
  ext n
  cases n with
  | zero => simp
  | succ n =>
    rw [coeff_expansion, expansionCoeff_succ, remainder_algebraMap ρ π hπ hker]
    simp [expansionCoeff]

