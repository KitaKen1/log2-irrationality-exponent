theorem HomogeneousPrimeStep.lt {I J : Ideal (MvPolynomial σ k)}
    (h : HomogeneousPrimeStep I J) : I < J := by logtwo_quiet
  obtain ⟨_, d, f, _, hfI, _, rfl⟩ := h
