  intro i hi
  apply (le_div_iff₀ (hv i)).mpr
  exact hμ i _ (PowerSeries.coe_toNat_order ((mem_active a i).mp hi)).symm

theorem order_add_lower (B : ℚ) (f g : PowerSeries ℂ)
    (hf : ∀ k : ℕ, f.order = (k : ℕ∞) → B ≤ (k : ℚ))
    (hg : ∀ k : ℕ, g.order = (k : ℕ∞) → B ≤ (k : ℚ))
