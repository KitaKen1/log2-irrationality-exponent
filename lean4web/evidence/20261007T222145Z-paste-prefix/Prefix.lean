theorem eventually_no_power_torsion [IsNoetherianRing R] (I : Ideal R) :
    ∃ N : ℕ, ∀ n ≥ N, ∀ x ∈ I ^ n,
      (∃ k : ℕ, ∀ a ∈ I ^ k, a * x = 0) → x = 0 := by logtwo_quiet
