    ∃ i, a i ≠ 0 ∧ contact v a hne = ((a i).order.toNat : ℚ) / v i := by logtwo_quiet
  obtain ⟨i,hi,he⟩ := Finset.exists_mem_eq_inf' (active_nonempty a hne)
    (fun i => ((a i).order.toNat : ℚ) / v i)
  exact ⟨i,(mem_active a i).mp hi,he⟩

