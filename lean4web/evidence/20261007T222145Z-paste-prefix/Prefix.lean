    (P : Ideal L) (hP : P ≤ RingHom.ker rho) (I : Ideal (FramePolynomial m))
    (cost : Fin (m + 1) → ℝ) (n : Fin k → ℕ) (δ : ℝ)
    (hn : ∀ i, 0 < n i) (hcost : ∀ i, 0 ≤ cost i)
