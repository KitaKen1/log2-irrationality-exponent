theorem cast_word_cost {ι : Type*} (v : ι → ℚ) (word : List ι) :
    (((word.map v).sum : ℚ) : ℝ) = (word.map (fun i => (v i : ℝ))).sum := by logtwo_quiet
  induction word with
  | nil => simp
  | cons i word ih => simp [ih]

