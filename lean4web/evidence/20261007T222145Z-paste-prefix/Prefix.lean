    (rho : L →+* K) (I : Ideal (FramePolynomial m))
    (cost : Fin (m + 1) → ℝ) (n : Fin k → ℕ) (δ : ℝ)
    (hcost : ∀ i, 0 ≤ cost i)
    (hn : ∑ i, ((n i - 1 : ℕ) : ℝ) * cost (B i) ≤ δ)
