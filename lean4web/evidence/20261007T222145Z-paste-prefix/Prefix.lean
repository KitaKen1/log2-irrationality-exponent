    (fun n hn => (hN n (by logtwo_quiet omega)).symm) rfl

end ProjectiveComponent

structure RetainedPrimeCycle (k : Type u) (σ : Type v) [Field k] where
  Index : Type w
  finiteIndex : Fintype Index
